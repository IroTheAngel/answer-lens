{
  "manifest_version": 3,
  "name": "Answer Lens",
  "version": "2.2.0",
  "description": "Snap any question on a page and get the answer with steps, plus AI chat and flashcards. Free and unlimited: it runs on Chrome's built-in AI, on your own PC.",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Answer Lens",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["frametext.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "commands": {
    "snap-full": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Snap the screen"
    },
    "snap-area": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Select an area to snap"
    }
  }
}
